# =========================================================================
# CivicGreenNet — Master Environment Configuration Template (.env.example)
# DO NOT ADD REAL SECRETS OR CREDENTIALS TO THIS FILE
# Copy this template to .env or server/.env / client/.env for local development
# =========================================================================

# Database — Neon PostgreSQL (Serverless PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_REQUIRE_SSL=true

# Server Runtime
PORT=5000
NODE_ENV=development

# JWT Authentication Secrets (64-character random hex keys)
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_ACCESS_EXP=15m
JWT_REFRESH_EXP=7d

# Resend Email Delivery
RESEND_API_KEY=your_resend_api_key
EMAIL_PROVIDER=resend
EMAIL_FROM="Civic GreenNet <notifications@civicgreennet.dev>"
EMAIL_REPLY_TO=civicgreenet@gmail.com

# Cloudinary CDN Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Services (Optional Advisory & Heuristic Fallbacks)
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Frontend Client Environment (Vite)
VITE_API_BASE=http://localhost:5000/api
VITE_FRONTEND_URL=http://localhost:5173
VITE_MAPTILER_API_KEY=your_maptiler_public_api_key
