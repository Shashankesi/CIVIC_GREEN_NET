# =========================================================================
# Civic GreenNet Backend — Environment Variables (.env.example)
# Backend secrets must NEVER be committed to Git or exposed to the client!
# =========================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=development

# Database — Neon PostgreSQL (Serverless PostgreSQL)
# Production format: postgresql://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_REQUIRE_SSL=true

# JWT Authentication Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_64_char_secure_random_hex_key
JWT_REFRESH_SECRET=replace_with_64_char_secure_random_hex_key
JWT_ACCESS_EXP=15m
JWT_REFRESH_EXP=7d

# Resend Email API (Official Verified Domain: civicgreennet.dev)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_PROVIDER=resend
EMAIL_FROM="Civic GreenNet <notifications@civicgreennet.dev>"
EMAIL_REPLY_TO=civicgreennet@gmail.com

# Cloudinary CDN (Image & Attachment Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Application URLs (CORS & Email Link Generation)
# Development: http://localhost:5173
# Production:  https://civicgreennet.dev
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
# Comma-separated additional allowed CORS origins (optional)
# ALLOWED_ORIGINS=https://civicgreennet.dev,https://www.civicgreennet.dev

# AI Services (Optional Advisory & Heuristic Fallbacks)
GEMINI_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Rate Limiting & Security (Optional Overrides)
# RATE_LIMIT_MAX=600
# AUTH_RATE_LIMIT_MAX=100
