# =========================================================================
# CivicGreenNet — Production-Safe .gitignore
# =========================================================================

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample

# Backend environment files
backend/.env
backend/.env.*
server/.env
server/.env.*
!server/.env.example
!server/.env.sample

# Frontend environment files
frontend/.env
frontend/.env.*
client/.env
client/.env.*
!client/.env.example
!client/.env.sample

# Credentials and private keys
*.pem
*.key
*.p12
*.pfx
*.crt
credentials.json
service-account*.json
secrets.json

# Database and local data
*.sqlite
*.sqlite3
*.db
dumps/
backups/

# Dependencies
node_modules/
client/node_modules/
server/node_modules/
vendor/

# Build outputs
dist/
build/
coverage/
client/dist/
client/build/
server/coverage/

# Logs & Debugging & Test outputs
*.log
logs/
server/*.log
*.txt
server/*.txt
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local IDE and OS files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
ehthumbs.db

# Temporary files & Scratch
*.tmp
*.temp
*.pid
*.seed
.cache/
tmp/
temp/
server/tmp/
server/uploads/
uploads/
brain/
scratch/
test.png
