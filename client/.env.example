# =========================================================================
# Civic GreenNet Client — Environment Variables (.env.example)
# All client-side variables MUST be prefixed with VITE_
# WARNING: NEVER put backend secrets, database credentials, or private API keys here!
# =========================================================================

# API Base URL (Backend API Endpoint)
# Development: http://localhost:5000/api
# Production:  https://api.civicgreennet.dev/api
VITE_API_BASE=http://localhost:5000/api

# Frontend URL (Application Origin)
# Development: http://localhost:5173
# Production:  https://civicgreennet.dev
VITE_FRONTEND_URL=http://localhost:5173

# MapTiler Public Client Key (Map Tiles & Forward/Reverse Geocoding)
# Get your free key at: https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_API_KEY=your_maptiler_public_api_key_here
